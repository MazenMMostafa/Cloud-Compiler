# Copy to .env (or set as Vercel environment variables) and fill in real values.
# Never commit a real .env file.

# Port the server listens on. Vercel sets PORT automatically.
PORT=3000

# Optional API key. When set, /compile requires: X-API-Key: <value>
# WARNING: a static key shipped inside an APK can be extracted by anyone.
# This is basic abuse mitigation, not strong authentication.
COMPILER_API_KEY=

# Path to arduino-cli. Defaults to "arduino-cli" on PATH (bundled in the image).
ARDUINO_CLI_PATH=arduino-cli
